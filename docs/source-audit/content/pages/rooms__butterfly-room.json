   "font": "madefor-text",
   "size": "16px",
   "weight": "400",
   "color": "#000000"
  },
  {
   "tag": "li",
   "text": "We are one of the few properties where it is safe to drink the water direct from our taps. Bali Lush has a private well and the water is sourced on site through 60M of volcanic rock.",
   "section_id": "comp-mfwniwpf",
