   "color": "#000000"
  },
  {
   "tag": "p",
   "text": "N.B the king beds in both Dragonfly and Butterfly rooms can not be split into twin singles like Frog Bungalow or Duck Cottage.",
   "section_id": "comp-mfwniwpf",
   "y": 2193,
   "font": "madefor-text",
